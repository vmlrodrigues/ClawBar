# Release + notarisation credentials. Copy to .env and fill in.
#
# Only needed to cut a signed, notarised release. Building locally needs none of this —
# Scripts/build.sh finds your Developer ID automatically, or SIGN=0 skips signing.
#
# .env points at a private key and must never be committed. It is in .gitignore.

# Optional: only if you have more than one Developer ID and want a specific one.
# RELEASE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
# RELEASE_TEAM="TEAMID1234"

# App Store Connect API key — preferred over an Apple ID app-specific password, since
# it needs no interactive credential storage.
# Create at https://appstoreconnect.apple.com → Users and Access → Integrations → Keys
NOTARY_KEY="/path/to/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
