# Release + notarisation credentials. Copy to .env and fill in.
#
# These are the same variables budgetry-mac-app and Siloquy already use, so the fastest
# setup is simply:
#
#     cp ~/Code/personal/budgetry-mac-app/.env .env
#
# .env holds a path to a private key and must never be committed.

RELEASE_SIGN_IDENTITY="Developer ID Application: Victor Rodrigues (9N354A3UZK)"
RELEASE_TEAM="9N354A3UZK"

# App Store Connect API key — preferred over an Apple ID app-specific password.
NOTARY_KEY="/path/to/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
